---
// Tema A · Valla de vía
import '@fontsource-variable/big-shoulders-display/wght';
import '@fontsource-variable/archivo/wght';
import '@fontsource-variable/jetbrains-mono/wght';
// Tema B · Fierro y tierra (sólo se descargan si el tema B está activo: @font-face es perezoso)
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/barlow-condensed/900.css';
import '@fontsource/barlow/200.css';
import '@fontsource/barlow/300.css';
import '@fontsource/barlow/400.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/700.css';
import '../styles/global.css';
import { marca } from '../config/marca';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo = `${marca.nombre} · ${marca.lema}`, descripcion = marca.descripcion } = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#F5C400" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Marca el documento como "con JS" antes de pintar: los estados iniciales de animación dependen de esto. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Vista previa de temas: ?tema=b activa "Fierro y tierra", ?tema=a vuelve a "Valla de vía".
      // La elección queda guardada en este navegador. Sólo para comparar; no es un selector público.
      try {
        var t = new URLSearchParams(location.search).get('tema');
        if (t === 'a' || t === 'b') localStorage.setItem('tema', t);
        var g = localStorage.getItem('tema');
        if (g && g !== 'a') document.documentElement.dataset.tema = g;
      } catch (e) {}
    </script>
  </head>
  <body class="bg-fondo text-tinta font-texto antialiased">
    <slot />
    <script src="../scripts/animaciones.ts"></script>
  </body>
</html>
