---
import Odometro from './Odometro.astro';
import { volqueta } from '../config/marca';
---

<section
  id="volqueta"
  class="px-gutter py-10 lg:pt-16 lg:pb-14 flex flex-col gap-4 lg:grid lg:grid-cols-[minmax(0,1fr)_460px] lg:gap-16 lg:items-end"
>
  <div class="flex flex-col gap-4 lg:gap-2">
    <h2 class="t-h2 m-0">La volqueta</h2>

    <div class="flex items-end gap-[18px] lg:gap-10 lg:mt-3">
      <div class="flex flex-col">
        <Odometro
          valor={volqueta.capacidadM3.valor}
          confirmado={volqueta.capacidadM3.confirmado}
          class="font-display font-black text-cifra tracking-[-0.03em] lg:tracking-[-0.04em]"
        />
        <span class="t-mono text-[14px] lg:text-[16px] mt-2 lg:mt-3">{volqueta.capacidadM3.unidad}</span>
      </div>
      <div class="flex flex-col pb-0.5">
        <Odometro
          valor={volqueta.cargaT.valor}
          confirmado={volqueta.cargaT.confirmado}
          class="font-display font-light lg:font-extralight text-cifra-2 tracking-[-0.02em] lg:tracking-[-0.03em]"
        />
        <span class="t-mono text-[14px] lg:text-[16px] mt-2 lg:mt-3 whitespace-nowrap"><span class="lg:hidden">{volqueta.cargaT.unidad}</span><span class="hidden lg:inline">{volqueta.cargaT.unidadLarga}</span></span>
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-3">
    <dl class="ficha m-0 border-t-[3px] border-negro mt-2 lg:mt-0">
      {
        volqueta.ficha.map((f) => (
          <div>
            <dt class="text-tinta-suave">{f.campo}</dt>
            <dd class="m-0 font-bold text-right">{f.valor}</dd>
          </div>
        ))
      }
    </dl>
    <p class="m-0 text-[13px] lg:text-[14px] text-tinta-suave">{volqueta.nota}</p>
  </div>
</section>
