---
/** Dónde: el mapa de Urabá dibujado con el scroll reemplaza la lista de municipios (animación 5). */
import MapaUraba from './MapaUraba.astro';
import { cobertura } from '../config/marca';
---

<section
  id="cobertura"
  class="bg-negro text-amarillo px-gutter py-10 lg:pt-16 lg:pb-14 flex flex-col gap-4 lg:grid lg:grid-cols-[420px_minmax(0,1fr)] lg:gap-12 lg:items-center"
>
  <div class="flex flex-col gap-2.5 lg:gap-4">
    <h2 class="t-h2 m-0">Dónde</h2>
    <p class="m-0 text-cuerpo-2 leading-[1.45] lg:leading-[1.5] text-gris-claro max-w-[34ch] lg:max-w-[36ch]">
      {cobertura.texto}
    </p>
    <p class="m-0 mt-2 font-display font-light text-ligero leading-none text-blanco uppercase lg:max-w-[14ch]">
      {cobertura.cierre}
    </p>
  </div>

  <MapaUraba class="w-full h-auto lg:w-auto lg:h-[min(82vh,900px)] lg:justify-self-center" />
</section>
